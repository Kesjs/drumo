# Site & legal entity
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ro

# Supabase (Auth, Postgres, private encrypted Storage, strict RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (card, Apple Pay / Google Pay, instant bank transfer)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional emails (Resend)
RESEND_API_KEY=
EMAIL_FROM=Drumo <noreply@drumo.ro>

# Scheduled jobs (Vercel Cron)
CRON_SECRET=

# Local session signing secret (used for session cookies & dev fallback)
SESSION_SECRET=change-me-in-production-min-32-chars
